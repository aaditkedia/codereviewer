<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>codeviewer</AssemblyName>
    <RootNamespace>CodeViewer</RootNamespace>
    <Version>1.2.0</Version>
    <!-- keep memory footprint small -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scintilla.NET" Version="5.3.2.9" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <!-- The Avalonia application is an independent sibling project. Keep the
       root WinForms project's default globs from compiling its source/output. -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <EmbeddedResource Remove="src\**\*" />
    <None Remove="src\**\*" />
  </ItemGroup>

</Project>
